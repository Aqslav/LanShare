<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LanShare.MainPage"
             Title="LAN Share">

    <Grid RowDefinitions="Auto,*">

        <!-- Заголовок і вкладки -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,4" Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Локальна файлова мережа" FontSize="24" FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Label x:Name="VersionLabel" Grid.Column="1" FontSize="11" Opacity="0.5" VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="TabNetworkButton" Grid.Column="0" Text="Мережа" Clicked="OnTabNetworkClicked" />
                <Button x:Name="TabMyPcButton" Grid.Column="1" Text="Мій комп'ютер" Clicked="OnTabMyPcClicked" />
            </Grid>
        </VerticalStackLayout>

        <!-- ===================== Вкладка «Мережа» ===================== -->
        <ScrollView x:Name="NetworkTab" Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="12">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="Комп'ютери в мережі" FontSize="18" FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <ActivityIndicator x:Name="ScanSpinner" Grid.Column="1" IsRunning="False" IsVisible="False"
                                       VerticalOptions="Center" />
                    <Button x:Name="RefreshButton" Grid.Column="2" Text="Оновити" Clicked="OnRefreshClicked" />
                </Grid>

                <Label x:Name="ScanStatus" FontSize="13" Opacity="0.7" />

                <VerticalStackLayout x:Name="ComputersLayout" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnComputerTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding DisplayName}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" FontSize="13" Opacity="0.65" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Entry x:Name="ManualEntry" Grid.Column="0" Placeholder="Не бачите комп'ютер? Введіть IP або ім'я"
                           Completed="OnManualConnect" />
                    <Button Grid.Column="1" Text="Відкрити" Clicked="OnManualConnect" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===================== Вкладка «Мій комп'ютер» ===================== -->
        <ScrollView x:Name="MyPcTab" Grid.Row="1" IsVisible="False">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="16">

                <!-- Налаштування -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Button x:Name="SetupButton" Text="Налаштувати комп'ютер" Clicked="OnSetupClicked" />

                        <HorizontalStackLayout Spacing="10">
                            <Switch x:Name="GuestSwitch" IsToggled="True" VerticalOptions="Center" />
                            <Label Text="Вхід без пароля" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label FontSize="12" Opacity="0.65"
                               Text="Для акаунтів без пароля; однаково на всіх комп'ютерах. Буде відкрито спільний доступ до файлів і віддалений робочий стіл. Мережа переводиться в профіль «Приватна»: не користуйтеся цим у громадських Wi-Fi мережах. Потрібне підтвердження адміністратора." />

                        <ActivityIndicator x:Name="SetupSpinner" IsRunning="False" IsVisible="False" />
                        <Label x:Name="SetupStatus" FontSize="13" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <!-- Спільні папки -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Спільні папки цього комп'ютера" FontSize="18" FontAttributes="Bold" />

                        <Label x:Name="MySharesEmpty" Text="Поки що жодної папки не відкрито." FontSize="13" Opacity="0.65" />

                        <VerticalStackLayout x:Name="MySharesLayout" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                                            <Label Text="{Binding Path}" FontSize="12" Opacity="0.65" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Видалити" Style="{StaticResource DangerButton}"
                                                Clicked="OnRemoveShareClicked" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#40808080" />

                        <Label Text="Додати папку" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="SharePathEntry" Grid.Column="0" Placeholder="Шлях до папки"
                                   TextChanged="OnSharePathChanged" />
                            <Button Grid.Column="1" Text="Огляд..." Clicked="OnBrowseClicked" />
                        </Grid>

                        <Entry x:Name="ShareNameEntry" Placeholder="Ім'я в мережі (необов'язково)" />

                        <Picker x:Name="AccessPicker" Title="Доступ" SelectedIndex="0">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Повний доступ (читання і запис)</x:String>
                                    <x:String>Лише читання</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <Button x:Name="ShareButton" Text="Поділитися папкою" Clicked="OnShareFolderClicked" />

                        <Label x:Name="ShareStatus" FontSize="13" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>

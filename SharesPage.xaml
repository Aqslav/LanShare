<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LanShare.SharesPage"
             Title="Спільні папки">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Заголовок -->
            <VerticalStackLayout Spacing="2">
                <Label x:Name="HeaderLabel" FontSize="24" FontAttributes="Bold" />
                <Label x:Name="AddressLabel" FontSize="13" Opacity="0.65" />
            </VerticalStackLayout>

            <!-- Кнопки (переносяться на малих екранах) -->
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button x:Name="RefreshButton" Text="Оновити" Clicked="OnRefreshClicked" Margin="0,0,8,8" />
                <Button Text="У Провіднику" Clicked="OnOpenInExplorerClicked" Margin="0,0,8,8" />
                <Button Text="Віддалений стіл" Clicked="OnRdpClicked" Margin="0,0,8,8" />
            </FlexLayout>

            <!-- Стан -->
            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
                <Label x:Name="StatusLabel" FontSize="14" />
            </HorizontalStackLayout>

            <Label x:Name="RdpLabel" FontSize="13" Opacity="0.8" />

            <!-- Вхід із логіном і паролем (з'являється за потреби) -->
            <Border x:Name="AuthPanel" Style="{StaticResource Card}" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Потрібен вхід" FontAttributes="Bold" />
                    <Label FontSize="12" Opacity="0.7"
                           Text="Введіть логін і пароль облікового запису того комп'ютера. Для локального акаунта вводьте у форматі ІМ'Я_КОМП'ЮТЕРА\логін." />
                    <Entry x:Name="UserEntry" Placeholder="Логін" />
                    <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True" Completed="OnLoginClicked" />
                    <Button Text="Увійти" Clicked="OnLoginClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Список папок -->
            <VerticalStackLayout x:Name="SharesLayout" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShareTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" FontSize="13" Opacity="0.65" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
